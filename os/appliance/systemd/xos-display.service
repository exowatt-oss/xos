[Unit]
Description=Xos display (Cage + Chromium full screen on the TV, run from the Xos server)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=xos
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland HOME=/var/lib/xos/home
EnvironmentFile=/etc/xos/appliance.env
StateDirectory=xos
StateDirectoryMode=0700
ExecStart=/opt/xos/current/os/appliance/xos-display
Restart=always
RestartSec=3
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=graphical.target
