[Unit]
Description=Xos kiosk (Cage Wayland compositor + Chromium, full screen on tty1)
After=xos-agent.service systemd-user-sessions.service
Wants=xos-agent.service
Conflicts=getty@tty1.service

[Service]
User=xos
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -fs http://127.0.0.1:7000/api/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/xos-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
